<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Center logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerVertical="true"
        android:layout_marginBottom="200dp">

        <ImageView
            android:id="@+id/busImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_compass"
            android:layout_gravity="center"
            android:layout_marginBottom="28dp"
            android:alpha="0"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Bus Tracker"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IIT Ropar"
            android:textSize="15sp"
            android:textColor="#6B7280"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Buttons at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="52dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <Button
            android:id="@+id/studentBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="I'm a Student"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#2196F3"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:alpha="0"/>

        <View android:layout_width="0dp" android:layout_height="12dp"/>

        <Button
            android:id="@+id/driverBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="I'm a Driver"
            android:textColor="#7C3AED"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_outline"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:alpha="0"/>

        <View android:layout_width="0dp" android:layout_height="8dp"/>

        <Button
            android:id="@+id/btnCalendar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="View Bus Schedule PDF"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:alpha="0"/>

    </LinearLayout>

</RelativeLayout>