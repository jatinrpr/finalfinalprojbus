<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Center logo area -->
    <LinearLayout
        android:id="@+id/logoArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerVertical="true"
        android:layout_marginBottom="180dp">

        <!-- Bus icon in violet circle -->
        <TextView
            android:id="@+id/busImage"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:text="🚌"
            android:textSize="44sp"
            android:gravity="center"
            android:background="@drawable/circle_violet"
            android:layout_gravity="center"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Bus Tracker"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:letterSpacing="0.01"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IIT Ropar"
            android:textSize="14sp"
            android:textColor="#71717A"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.08"/>

    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="52dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- Student Button -->
        <Button
            android:id="@+id/studentBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="I'm a Student"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:alpha="0"/>

        <View android:layout_width="0dp" android:layout_height="12dp"/>

        <!-- Driver Button -->
        <Button
            android:id="@+id/driverBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="I'm a Driver"
            android:textColor="#8B5CF6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_outline"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:alpha="0"/>

        <View android:layout_width="0dp" android:layout_height="10dp"/>

        <!-- Bus Calendar -->
        <Button
            android:id="@+id/btnCalendar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="📄  View Bus Schedule PDF"
            android:textColor="#71717A"
            android:textSize="13sp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:alpha="0"/>

    </LinearLayout>

</RelativeLayout>