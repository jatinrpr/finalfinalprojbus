<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="40dp">

        <!-- Icon -->
        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="👤"
            android:textSize="30sp"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="28dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to your account"
            android:textColor="#71717A"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="44dp"/>

        <!-- Email label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gmail Address"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <!-- Email field -->
        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="name@gmail.com"
            android:textColorHint="#3F3F46"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/input_bg"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="20dp"/>

        <!-- Password label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <!-- Password field -->
        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Enter your password"
            android:textColorHint="#3F3F46"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/input_bg"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:inputType="textPassword"
            android:layout_marginBottom="36dp"/>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Login button -->
        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Sign In"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:elevation="0dp"/>

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/divider_bg"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   No account?   "
                android:textColor="#3F3F46"
                android:textSize="13sp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/divider_bg"/>

        </LinearLayout>

        <!-- Create Account -->
        <TextView
            android:id="@+id/createAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Create Account"
            android:textColor="#8B5CF6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/btn_outline"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>
</ScrollView>