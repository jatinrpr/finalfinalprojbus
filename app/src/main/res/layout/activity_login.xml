<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080E1C"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="700dp">

        <!-- Top glow -->
        <View
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="-60dp"
            android:background="@drawable/glow_circle"
            android:alpha="0.2"/>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginTop="72dp">

            <!-- Icon + Title -->
            <TextView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="👤"
                android:textSize="28sp"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textColor="#F1F5F9"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to track your bus"
                android:textColor="#64748B"
                android:textSize="15sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="40dp"/>

            <!-- Email field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gmail Address"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="name@gmail.com"
                android:textColorHint="#334155"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:background="@drawable/input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="20dp"/>

            <!-- Password field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter your password"
                android:textColorHint="#334155"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:background="@drawable/input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textPassword"
                android:layout_marginBottom="32dp"/>

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Login button -->
            <Button
                android:id="@+id/loginBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sign In"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1E293B"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  New here?  "
                    android:textColor="#475569"
                    android:textSize="13sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1E293B"/>

            </LinearLayout>

            <!-- Create account -->
            <TextView
                android:id="@+id/createAccount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Create Account"
                android:textColor="#0EA5E9"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/btn_outline"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </RelativeLayout>
</ScrollView>