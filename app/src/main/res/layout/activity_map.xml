<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/header_bg"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Back"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"/>

        <TextView
            android:id="@+id/tvBusTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bus"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"/>

        <View android:layout_width="72dp" android:layout_height="1dp"/>

    </LinearLayout>

    <!-- Stops dropdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Stop for ETA"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/stopSpinner"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/spinner_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:popupBackground="#FFFFFF"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_bg"/>

    <!-- Map -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- ETA bar - active tracking -->
    <LinearLayout
        android:id="@+id/layoutTracking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/eta_bar_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculating ETA..."
            android:textColor="#1D4ED8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Not sharing panel -->
    <LinearLayout
        android:id="@+id/layoutNotSharing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/not_sharing_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNotSharingMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location not being shared yet"
            android:textColor="#92400E"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"/>

    </LinearLayout>

</LinearLayout>